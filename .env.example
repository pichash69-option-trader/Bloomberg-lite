# ─── Bloomberg-lite — environment (copy to .env and fill in) ───
# NEVER commit the real .env (it is gitignored).

# --- DhanHQ API creds (from Dhan web portal → DhanHQ → Access Token) ---
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# --- Postgres / TimescaleDB ---
POSTGRES_USER=bloomberg
POSTGRES_PASSWORD=bloomberg
POSTGRES_DB=bloomberg_lite
POSTGRES_HOST=db          # 'db' inside Docker network; 'localhost' for local dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis          # 'redis' inside Docker; 'localhost' for local dev
REDIS_PORT=6379

# --- App ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
TZ=Asia/Kolkata
